@model HelpDeskWeb.Models.Ticket

@{
    ViewData["Title"] = "Müraciət Detalları";
}

<h2 class="mb-4">Müraciət #@Model.Id — Detallar</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-3">Kateqoriya:</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Prioritet:</dt>
            <dd class="col-sm-9">@Model.Priority</dd>

            <dt class="col-sm-3">Status:</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Yaradılma tarixi:</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Təsvir:</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Redaktə et</a>
    <a asp-action="Index" class="btn btn-secondary">Siyahıya qayıt</a>
</div>