@model HelpDeskWeb.Models.Ticket

@{
    ViewData["Title"] = "Yeni Müraciət";
}

<h2 class="mb-4">Yeni Texniki Dəstək Müraciəti</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlıq</label>
                <input asp-for="Title" class="form-control" placeholder="Məs: İnternet bağlantısı kəsilir" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Kateqoriya</label>
                <select asp-for="Category" class="form-select">
                    <option value="">-- Seçin --</option>
                    <option value="Hardware">Hardware (Avadanlıq)</option>
                    <option value="Software">Software (Proqram təminatı)</option>
                    <option value="Network">Network (Şəbəkə)</option>
                    <option value="Access / Account">Access / Account (Hesab və Giriş)</option>
                </select>
                <span asp-validation-for="Category" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label">Prioritet</label>
                <select asp-for="Priority" class="form-select">
                    <option value="Low">Low (Aşağı)</option>
                    <option value="Normal" selected>Normal (Orta)</option>
                    <option value="High">High (Yüksək)</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Problemin təsviri</label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Problemi ətraflı izah edin..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Göndər</button>
            <a asp-action="Index" class="btn btn-secondary">Geri</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}